# =============================================================================
# Olive & Dreams: Supabase Backend Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase Project Configuration (Client & Edge Functions)
# -----------------------------------------------------------------------------
# Found in your Supabase Dashboard under Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Frontend Website URL (used for Paystack checkout redirects)
SITE_URL=https://oliveanddreams.com

# -----------------------------------------------------------------------------
# 2. Payment Gateway: Paystack
# -----------------------------------------------------------------------------
# Found in your Paystack Dashboard under Settings -> API Keys & Webhooks
# Use test keys (sk_test_... / pk_test_...) during development
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# 3. Transactional Email: Resend
# -----------------------------------------------------------------------------
# Found in your Resend Dashboard (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified sender domain in Resend (e.g. orders@yourdomain.com)
# For testing without a custom domain, use: onboarding@resend.dev
RESEND_FROM_EMAIL="Olive & Dreams <orders@oliveanddreams.com>"

# -----------------------------------------------------------------------------
# 4. Default Store Admin Seed Credentials
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@oliveanddreams.com
